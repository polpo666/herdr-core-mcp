{
  "name": "herdr-core-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server that exposes herdr-core terminals to ChatGPT web over OAuth 2.1",
  "type": "module",
  "license": "Apache-2.0",
  "author": "polpo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polpo666/herdr-core-mcp.git"
  },
  "homepage": "https://github.com/polpo666/herdr-core-mcp#readme",
  "bugs": {
    "url": "https://github.com/polpo666/herdr-core-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "connector",
    "herdr",
    "terminal",
    "coding-agents"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
